{
  "name": "photo-exif-util",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "pack:zip": "tsx scripts/pack-zip.ts",
    "gen:icons": "tsx scripts/generate-icons.ts",
    "release": "pnpm build && pnpm pack:zip",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@kobalte/core": "0.13.7",
    "@solidjs/router": "0.15.2",
    "clsx": "2.1.1",
    "exifr": "7.1.3",
    "fflate": "0.8.2",
    "lucide-solid": "0.469.0",
    "pica": "9.0.1",
    "piexifjs": "1.0.6",
    "solid-js": "1.9.12",
    "zod": "3.24.1"
  },
  "pnpm": {
    "overrides": {
      "rollup": ">=4.34.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@crxjs/vite-plugin": "2.0.0-beta.28",
    "@playwright/test": "1.59.1",
    "@solidjs/testing-library": "0.8.10",
    "@tailwindcss/vite": "4.2.4",
    "@testing-library/jest-dom": "6.6.3",
    "@types/chrome": "0.0.290",
    "@types/pica": "9.0.4",
    "@vitest/coverage-v8": "2.1.9",
    "jsdom": "25.0.1",
    "lefthook": "1.10.1",
    "tailwindcss": "4.2.4",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "6.4.2",
    "vite-plugin-solid": "2.11.0",
    "vitest": "2.1.9"
  }
}
